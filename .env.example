# 复制此文件为 .env 并填入你自己的密钥
# cp .env.example .env

# SiliconFlow 大模型 API（https://siliconflow.cn）
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Tavily 联网搜索 API（https://tavily.com）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./novel_writer.db

# ChromaDB 向量库持久化目录
CHROMA_PERSIST_DIR=./chroma_data
